{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Caprine (Visnia)",
	"version": "3.0.0-alpha.1",
	"identifier": "com.visnia.caprine",
	"build": {
		"beforeDevCommand": "npm run build",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {"capabilities": ["messenger"]}
	},
	"bundle": {
		"active": true,
		"publisher": "visnia",
		"homepage": "https://github.com/visnia/caprine",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.ico"],
		"category": "SocialNetworking",
		"shortDescription": "Minimal Messenger wrapper",
		"windows": {
			"minimumWebview2Version": "128.0.2739.15",
			"webviewInstallMode": {"type": "downloadBootstrapper", "silent": true},
			"nsis": {"startMenuFolder": "Visnia", "installerHooks": "installer/hooks.nsh"}
		}
	},
	"plugins": {
		"updater": {
			"endpoints": ["https://github.com/visnia/caprine/releases/latest/download/latest.json"],
			"requireSignedVersion": true
		}
	}
}
