{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "messenger",
	"description": "Only the main Messenger webview can call Caprine's narrow integration commands.",
	"local": false,
	"remote": {"urls": ["https://www.messenger.com"]},
	"webviews": ["main"],
	"platforms": ["windows", "linux"],
	"permissions": ["allow-bootstrap", "allow-open-external", "allow-log-service-worker-inventory", "allow-get-settings", "allow-update-setting", "allow-panel-action", "allow-report-unread", "allow-collect-notification", "allow-updater-action", "core:event:allow-listen", "core:event:allow-unlisten"]
}
