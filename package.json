{
	"name": "caprine",
	"productName": "caprine",
	"version": "3.0.2",
	"private": true,
	"description": "Minimal Messenger wrapper for Windows and Linux",
	"author": "visnia",
	"license": "MIT",
	"repository": "github:visnia/caprine",
	"homepage": "https://github.com/visnia/caprine",
	"bugs": {
		"url": "https://github.com/visnia/caprine/issues"
	},
	"type": "module",
	"main": "dist/main.js",
	"desktopName": "caprine.desktop",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc --noEmit && node scripts/build.mjs",
		"test": "npm run build && node --test tests/*.test.mjs",
		"start": "npm run build && electron .",
		"dist:win": "npm run build && electron-builder --win",
		"dist:linux": "npm run build && electron-builder --linux"
	},
	"dependencies": {
		"@particle/dbus-next": "0.11.4",
		"electron-updater": "6.8.9"
	},
	"devDependencies": {
		"electron": "44.7.0",
		"electron-builder": "26.15.3",
		"esbuild": "0.28.2",
		"linkedom": "0.18.13",
		"typescript": "7.0.2"
	},
	"build": {
		"appId": "com.visnia.caprine",
		"files": [
			"dist/**",
			"icons/**"
		],
		"asarUnpack": [
			"icons/icon.png"
		],
		"directories": {
			"output": "release"
		},
		"publish": {
			"provider": "github",
			"owner": "visnia",
			"repo": "caprine",
			"releaseType": "draft"
		},
		"win": {
			"target": "nsis",
			"icon": "icons/icon.ico"
		},
		"nsis": {
			"oneClick": true,
			"perMachine": false
		},
		"linux": {
			"target": "AppImage",
			"icon": "icons/icon.png",
			"category": "Network",
			"executableName": "caprine",
			"syncDesktopName": true
		}
	}
}
