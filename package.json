{
	"name": "caprine",
	"version": "3.0.0-alpha.1",
	"private": true,
	"description": "Minimal Messenger wrapper for Windows and Linux",
	"license": "MIT",
	"repository": "github:visnia/caprine",
	"homepage": "https://github.com/visnia/caprine",
	"bugs": {"url": "https://github.com/visnia/caprine/issues"},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc --noEmit && node scripts/build-inject.mjs",
		"test": "npm run build && node --test tests/*.test.mjs",
		"start": "tauri dev",
		"tauri": "tauri",
		"build:app": "tauri build --no-bundle",
		"dist:win": "tauri build --bundles nsis",
		"dist:linux": "tauri build --bundles appimage,deb"
	},
	"dependencies": {
		"@tauri-apps/api": "2.12.1"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.12.1",
		"esbuild": "0.28.2",
		"typescript": "7.0.2"
	}
}
